# 搜索（三选一，不配 Key 时默认用 DuckDuckGo 免费搜索）
# 方案1 - 免费默认：DuckDuckGo，无需配置
#
# 方案2 - Google 免费额度：100 次/天
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
#
# 方案3 - 付费（可选）：SerpAPI
# SERPAPI_KEY=

# OpenAI - keyword generation & lead scoring (optional, has template fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server
HOST=127.0.0.1
PORT=8000
